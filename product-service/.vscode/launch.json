{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Product Service",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--nolazy"],
      "env": { "NODE_ENV": "development" },
      "console": "integratedTerminal",
      "skipFiles": [
  "<node_internals>/**",
  "**/node_modules/sequelize/**"
]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Running Process",
      "port": 9229,
      "address": "localhost",
      "restart": false,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": null
    }
  ]
}
