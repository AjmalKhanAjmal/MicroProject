Promise Example code : 

// app.js
const express = require("express");
const app = express();
app.use(express.json());

// --- Mock async functions implemented with Promises ---
function saveOrderToDatabase(orderData) {
  return new Promise((resolve, reject) => {
    // simulate async DB save
    setTimeout(() => {
      // simulate success - add an id and return saved order
      resolve({ ...orderData, orderId: Date.now() });
      // if you want to simulate failure use: reject(new Error("DB failed"));
    }, 200); // 200ms
  });
}

function sendEmail(order) {
  return new Promise((resolve) => {
    setTimeout(() => {
      console.log("Email sent for order", order.orderId);
      resolve();
    }, 300);
  });
}

function reduceStock(order) {
  return new Promise((resolve) => {
    setTimeout(() => {
      console.log("Stock reduced for order", order.orderId);
      resolve();
    }, 250);
  });
}

function sendSMS(phone) {
  return new Promise((resolve) => {
    setTimeout(() => {
      console.log("SMS sent to", phone);
      resolve();
    }, 150);
  });
}

// --- 1) Promise-based (then/catch) version ---
app.post("/place-order-promise", (req, res) => {
  saveOrderToDatabase(req.body)
    .then((order) => {
      // fire-and-forget non-blocking tasks
      sendEmail(order).catch((e) => console.error("Email error:", e));
      reduceStock(order).catch((e) => console.error("Stock error:", e));
      sendSMS(order.phone).catch((e) => console.error("SMS error:", e));

      // respond quickly
      res.send({ message: "Order Placed Successfully (promise)", orderId: order.orderId });
    })
    .catch((err) => {
      console.error("DB error:", err);
      res.status(500).send({ message: "Order failed", error: err.message });
    });
});

// --- 2) async/await version with parallel post-processing (recommended) ---
app.post("/place-order", async (req, res) => {
  try {
    // save order (await since we need order object first)
    const order = await saveOrderToDatabase(req.body);

    // Start other tasks in parallel (don't await each one sequentially if you don't need to)
    const emailPromise = sendEmail(order);
    const stockPromise = reduceStock(order);
    const smsPromise = sendSMS(order.phone);

    // Respond to client immediately with success (non-blocking)
    res.send({ message: "Order Placed Successfully", orderId: order.orderId });

    // Option A: wait for all to finish and log (optional background handling)
    // await Promise.all([emailPromise, stockPromise, smsPromise]);
    // console.log("All post-order tasks finished for", order.orderId);

    // Option B: handle individually (allow independent failures)
    emailPromise.catch(e => console.error("Email error:", e));
    stockPromise.catch(e => console.error("Stock error:", e));
    smsPromise.catch(e => console.error("SMS error:", e));

  } catch (err) {
    console.error("place-order error:", err);
    res.status(500).send({ message: "Order failed", error: err.message });
  }
});

app.listen(3000, () => console.log("Server listening on :3000"));




